DOCOPS_ENVIRONMENT=production

# Use a password manager or: python -c "import secrets; print(secrets.token_urlsafe(32))"
DOCOPS_API_KEYS=ui:admin:CHANGE_THIS_TO_THE_SAME_RANDOM_SECRET_BELOW
DOCOPS_UI_API_KEY=CHANGE_THIS_TO_THE_SAME_RANDOM_SECRET_ABOVE
DOCOPS_UI_PASSWORD=CHANGE_THIS_TO_A_DIFFERENT_RANDOM_UI_PASSWORD

DOCOPS_LLM_PROVIDER=extractive
DOCOPS_LLM_BASE_URL=https://api.openai.com/v1
DOCOPS_LLM_API_KEY=
DOCOPS_LLM_MODEL=

DOCOPS_TOP_K=4
DOCOPS_MIN_EVIDENCE_SCORE=0.08
DOCOPS_MAX_UPLOAD_BYTES=10485760
DOCOPS_APPROVAL_TTL_SECONDS=900
DOCOPS_DATABASE_PATH=/state/docops.db

DOCOPS_TRUSTED_HOSTS=api.example.com,localhost,127.0.0.1,api
DOCOPS_CORS_ORIGINS=https://docops.example.com
DOCOPS_LOG_LEVEL=INFO
DOCOPS_DOCS_ENABLED=false

DOCOPS_BIND_HOST=127.0.0.1
DOCOPS_API_PORT=8000
DOCOPS_UI_PORT=8501
